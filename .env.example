# Salin jadi .env lalu sesuaikan.

# Port web
PORT=3000

# Password admin pertama (hanya dipakai saat database masih kosong).
# Kalau dikosongkan, password acak akan dicetak di log saat pertama jalan.
# ADMIN_PASSWORD=

# Alamat API MediaMTX (biasanya tidak perlu diubah)
# MEDIAMTX_API=http://127.0.0.1:9997

# URL WebRTC MediaMTX yang dipakai browser. Kosong = hostname yang sama
# dengan web + port 8889. Isi kalau pakai reverse proxy / domain, mis.
# WEBRTC_PUBLIC_URL=https://cctv.perusahaan.co.id/webrtc
# WEBRTC_PORT=8889

# Isi true kalau web di belakang nginx + HTTPS
# TRUST_PROXY=true
# SECURE_COOKIE=true

# Lama login (jam)
# SESSION_HOURS=12
